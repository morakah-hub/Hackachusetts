<!--
  Known-world pick-and-place scene (v0.6): the table of table.xml with one free
  rigid box to be picked up and a visual-only placement marker. The box moves only
  through contact and friction (free joint, simulated by mj_step); its initial
  pose, mass and friction can be changed per episode through environment_overrides
  (bodies.object.pos, geoms.object_geom.mass / friction) without editing this file.

  Box: 50 x 50 x 60 mm (x, y, z), 0.4 kg by default (density ~2700 kg/m^3, i.e. a
  solid aluminium block). Friction 1.0 (MuJoCo takes the larger of the two geoms'
  coefficients; the Panda pads are 1.0), condim 4 (adds torsional friction).
-->
<mujoco model="pick_place_env">
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <statistic center="0.4 0 0.5" extent="1.0"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wood" rgba="0.55 0.38 0.22 1"/>
    <material name="object" rgba="0.95 0.55 0.1 1"/>
    <material name="place" rgba="0.1 0.8 0.2 0.5"/>
    <material name="target" rgba="1 0.1 0.1 0.6"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light pos="1.5 -1.5 2.5" dir="-1 1 -1.2" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Table: top surface at z = 0.40 m, spans x in [-0.20, 0.90], y in [-0.50, 0.50]. -->
    <body name="table" pos="0.35 0 0">
      <geom name="table_top" type="box" size="0.55 0.5 0.02" pos="0 0 0.38" material="wood"/>
      <geom name="table_leg1" type="box" size="0.025 0.025 0.18" pos=" 0.5  0.45 0.18" material="wood"/>
      <geom name="table_leg2" type="box" size="0.025 0.025 0.18" pos=" 0.5 -0.45 0.18" material="wood"/>
      <geom name="table_leg3" type="box" size="0.025 0.025 0.18" pos="-0.5  0.45 0.18" material="wood"/>
      <geom name="table_leg4" type="box" size="0.025 0.025 0.18" pos="-0.5 -0.45 0.18" material="wood"/>
    </body>

    <!-- The manipulated object: resting on the table (center 30 mm above the top). -->
    <body name="object" pos="0.5 0.2 0.43">
      <freejoint name="object_free"/>
      <geom name="object_geom" type="box" size="0.025 0.025 0.03" mass="0.4" friction="1 0.005 0.0001"
        condim="4" material="object"/>
    </body>

    <!-- Placement target (visual only): object center goes to this body's position. -->
    <body name="place_marker" pos="0.5 -0.2 0.43">
      <geom name="place_marker" type="box" size="0.03 0.03 0.0005" pos="0 0 -0.0295" material="place"
        contype="0" conaffinity="0"/>
    </body>

    <site name="robot_mount" pos="0 0 0.40"/>

    <!-- Visual-only target marker (mocap: moved kinematically, never collides). -->
    <body name="target" mocap="true" pos="0.5 0 0.8">
      <geom name="target_marker" type="sphere" size="0.01" material="target" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
