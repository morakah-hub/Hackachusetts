<!--
  Narrow-passage planning scene (v0.5 benchmark): the wall of planning_demo.xml
  under a ceiling plate that covers the whole table. Going over the wall must
  pass through the gap between the wall top (z = 0.66) and the ceiling, and the
  arm can no longer swing up over its own base to get around the wall's end.
  Used by configs/benchmark_planning.yaml (scenario narrow_passage).
-->
<mujoco model="planning_narrow_env">
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="200" elevation="-20"/>
  </visual>

  <statistic center="0.4 0 0.6" extent="1.0"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wood" rgba="0.55 0.38 0.22 1"/>
    <material name="obstacle" rgba="0.2 0.6 0.9 1"/>
    <material name="target" rgba="1 0.1 0.1 0.6"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light pos="1.5 -1.5 2.5" dir="-1 1 -1.2" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Table: top surface at z = 0.40 m, spans x in [-0.20, 0.90], y in [-0.50, 0.50]. -->
    <body name="table" pos="0.35 0 0">
      <geom name="table_top" type="box" size="0.55 0.5 0.02" pos="0 0 0.38" material="wood"/>
      <geom name="table_leg1" type="box" size="0.025 0.025 0.18" pos=" 0.5  0.45 0.18" material="wood"/>
      <geom name="table_leg2" type="box" size="0.025 0.025 0.18" pos=" 0.5 -0.45 0.18" material="wood"/>
      <geom name="table_leg3" type="box" size="0.025 0.025 0.18" pos="-0.5  0.45 0.18" material="wood"/>
      <geom name="table_leg4" type="box" size="0.025 0.025 0.18" pos="-0.5 -0.45 0.18" material="wood"/>
    </body>

    <!-- Wall: x in [0.25, 0.80], y in [-0.02, 0.02], z in [0.40, 0.66]. -->
    <body name="wall" pos="0.525 0 0.53">
      <geom name="wall" type="box" size="0.275 0.02 0.13" material="obstacle"/>
    </body>

    <!-- Ceiling plate over the table: x in [-0.20, 0.90], y in [-0.50, 0.50], z in [1.00, 1.04]. -->
    <body name="ceiling" pos="0.35 0 1.02">
      <geom name="ceiling" type="box" size="0.55 0.5 0.02" material="obstacle" rgba="0.2 0.6 0.9 0.35"/>
    </body>

    <site name="robot_mount" pos="0 0 0.40"/>

    <!-- Visual-only target marker (mocap: moved kinematically, never collides). -->
    <body name="target" mocap="true" pos="0.5 0 0.8">
      <geom name="target_marker" type="sphere" size="0.03" material="target" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
